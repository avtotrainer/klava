<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="KLAVA" Manufacturer="KLAVA" Version="0.3.2" UpgradeCode="BE1E5D5B-9D2E-4CE7-9DAD-CA7A46C6F91A" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer KLAVA MSI is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- Existing Inno Setup registration; never auto-remove another package. -->
    <Property Id="KLAVA_INNO_MACHINE" Secure="yes">
      <RegistrySearch Id="FindKLAVAInnoMachine" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\KLAVA.CurrentUser_is1" Name="UninstallString" Type="raw" />
    </Property>
    <Property Id="KLAVA_INNO_USER" Secure="yes">
      <RegistrySearch Id="FindKLAVAInnoUser" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\KLAVA.CurrentUser_is1" Name="UninstallString" Type="raw" />
    </Property>
    <Launch Condition="Installed OR (NOT KLAVA_INNO_MACHINE AND NOT KLAVA_INNO_USER)" Message="KLAVA is already installed using the EXE setup. Uninstall that copy before installing the MSI. Your personal exercises are preserved." />
    <!-- Do not overlay Inno Setup installations: the two installers have
         independent servicing/uninstallation databases. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="KLAVA MSI" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="KLAVAProgramMenu" Name="KLAVA" />
    </StandardDirectory>
    <Feature Id="Main" Title="KLAVA" Level="1">
      <ComponentGroupRef Id="KLAVAFiles" />
      <ComponentRef Id="KLAVAStartMenuShortcut" />
    </Feature>
  </Package>
  <Fragment>
    <DirectoryRef Id="KLAVAProgramMenu">
      <Component Id="KLAVAStartMenuShortcut" Guid="*">
        <Shortcut Id="KLAVAStartShortcut" Name="KLAVA" Target="[INSTALLFOLDER]KLAVA.exe" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        <RemoveFolder Id="RemoveKLAVAProgramMenu" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\\KLAVA\\MSI" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <ComponentGroup Id="KLAVAFiles" Directory="INSTALLFOLDER">
      <Component Id="KLAVAExecutable" Guid="*">
        <File Id="KLAVAExe" Source="$(var.SourceDir)\KLAVA.exe" KeyPath="yes" />
      </Component>
      <Component Id="DefaultExercises" Guid="*">
        <File Id="ExercisesFile" Source="$(var.SourceDir)\default-exercises.klv" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
